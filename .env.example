# Database
DATABASE_URL="file:./dev.db"

# Admin back-office auth (MVP shared credential; replace with bank SSO/IAM before launch)
ADMIN_USERNAME="broker"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Public app URL (used for absolute links in emails / .ics)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Investments mailbox that receives new/cancelled/rescheduled booking notifications
INVESTMENTS_MAILBOX="Investments@conversebank.am"

# --- Provider adapters ---
# NOTIFICATIONS_PROVIDER=console (default, logs to server console/DB) | smtp | custom
NOTIFICATIONS_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Converse Bank <no-reply@conversebank.am>"

# SMS_PROVIDER=console (default, logs OTP/reminders to server console/DB) | custom
SMS_PROVIDER="console"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="ConverseBank"

# Business rules. Weekly availability (which days are open + hours) and the
# call length / buffer / booking window / minimum notice below are only
# SEED DEFAULTS, applied once to the DB the first time the app reads them;
# after that they're broker-editable from /admin/settings without a
# redeploy. Hold duration, the per-contact booking cap and retention stay
# env-only (rarely change, no broker-facing UI for them).
BOOKING_SLOT_MINUTES="10"
BOOKING_BUFFER_MINUTES="5"
BOOKING_HORIZON_DAYS="3"
BOOKING_MIN_LEAD_MINUTES="30"
BOOKING_HOLD_MINUTES="10"
BOOKING_MAX_ACTIVE_PER_CONTACT="1"
BOOKING_RETENTION_DAYS="365"

# Shared secret required in the X-Cron-Secret header when calling
# /api/cron/reminders and /api/cron/cleanup from an external scheduler.
CRON_SECRET="replace-with-a-long-random-string"
